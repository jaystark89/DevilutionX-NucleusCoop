+void GameController::SetPreferredController(int index)
+{
+	preferred_controller_index_ = index;
+}
+
+bool GameController::IsPreferredController(int index)
+{
+	return preferred_controller_index_ < 0 || index == preferred_controller_index_;
+}
+
 void GameController::Add(int joystickIndex)
 {
+	if (preferred_controller_index_ >= 0 && joystickIndex != preferred_controller_index_) {
+		Log("Ignoring game controller at index {} (selected controller is {})",
+		    joystickIndex, preferred_controller_index_);
+		return;
+	}
+
 	Log("Opening game controller for joystick at index {}", joystickIndex);
 	GameController result;
 	result.sdl_game_controller_ = SDL_GameControllerOpen(joystickIndex);
